# Copy this file to ".env" and fill in the keys you have.
# Every key is OPTIONAL — JARVIS runs without them, it just skips those features.

# Google Gemini — powers conversation + the "ask me anything" fallback.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenWeatherMap — "weather in <city>". https://openweathermap.org/api
OPENWEATHER_API_KEY=

# GNews — real headlines for "news". https://gnews.io  (else Gemini is used)
GNEWS_API_KEY=

# WolframAlpha — advanced math. https://developer.wolframalpha.com
WOLFRAM_APP_ID=

# Gmail — for sending email (use a Google "App Password", not your login).
EMAIL_SENDER=
EMAIL_PASSWORD=

# Default city used by the "briefing" command's weather.
DEFAULT_CITY=

# Spotify — play music with "play <song> on spotify".
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
