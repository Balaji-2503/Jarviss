# ================= MAIN COMMAND HANDLER =================
def run_jarvis():
    wish_me()
    while True:
        query = take_command()

        if not query:
            continue

        # Application Control
        if 'open' in query:
            app_name = query.replace('open', '').strip()
            open_application(app_name)

        # Information Commands
        elif 'wikipedia' in query:
            try:
                speak("Searching Wikipedia...")
                query = query.replace("wikipedia", "")
                results = wikipedia.summary(query, sentences=2)
                speak("According to Wikipedia")
                speak(results)
            except:
                search_web(query)

        elif 'search' in query or 'what is' in query or 'who is' in query or 'how to' in query:
            search_web(query)

        elif 'time' in query:
            get_time()

        elif 'date' in query:
            get_date()

        # System Control
        elif 'shutdown' in query or 'restart' in query or 'sleep' in query or 'lock' in query:
            system_command(query)

        # Productivity
        elif 'note' in query or 'remember' in query:
            speak("What should I remember?")
            note_text = take_command()
            note(note_text)

        elif 'calendar events' in query or 'upcoming events' in query:
            get_calendar_events()

        elif 'add event' in query:
            try:
                speak("What's the event about?")
                summary = take_command()
                speak("When should it start? (Format: YYYY-MM-DDTHH:MM:SS)")
                start_time = take_command()
                speak("How long will it last in minutes?")
                duration = take_command()
                add_calendar_event(summary, start_time, int(duration))
            except Exception as e:
                speak("Failed to add event")
                print(f"Calendar error: {e}")

        # Communication
        elif 'send whatsapp message' in query or 'whatsapp message' in query:
            try:
                speak("Who do you want to send the message to? Please say the phone number.")
                contact = take_command().replace(" ", "")
                speak("What should I say?")
                message = take_command()
                send_whatsapp_message(contact, message)
            except Exception as e:
                speak("Failed to send WhatsApp message")
                print(f"WhatsApp error: {e}")

        elif 'send email' in query:
            try:
                speak("Who should I send the email to?")
                recipient = take_command()
                speak("What should be the subject?")
                subject = take_command()
                speak("What should I say in the email?")
                body = take_command()
                send_email(recipient, subject, body)
            except Exception as e:
                speak("Failed to compose email")
                print(f"Email error: {e}")

        # Media Control
        elif 'play' in query and ('song' in query or 'music' in query):
            song_name = query.replace('play', '').replace('song', '').replace('music', '').strip()
            if 'on spotify' in song_name:
                song_name = song_name.replace('on spotify', '').strip()
                play_on_spotify(song_name)
            else:
                play_on_youtube(song_name)

        # News and Information
        elif 'news' in query:
            category = 'general'
            if 'sports' in query:
                category = 'sports'
            elif 'technology' in query or 'tech' in query:
                category = 'technology'
            elif 'business' in query:
                category = 'business'
            elif 'entertainment' in query:
                category = 'entertainment'
            elif 'health' in query:
                category = 'health'
            elif 'science' in query:
                category = 'science'
            get_news(category)

        elif 'weather' in query:
            city = query.replace('weather', '').replace('in', '').strip()
            if not city:
                speak("Which city's weather would you like to know?")
                city = take_command()
            get_weather(city)

        # Utilities
        elif 'joke' in query:
            tell_joke()

        elif 'calculate' in query or 'what is' in query and (
                'plus' in query or 'minus' in query or 'times' in query or 'divided by' in query):
            calculate(query)

        elif 'remind me to' in query:
            reminder_text = query.split('remind me to')[1].split('in')[0].strip()
            time_part = query.split('in')[1].split('minutes')[0].strip()
            try:
                minutes = int(time_part)
                Thread(target=set_reminder, args=(reminder_text, minutes)).start()
            except:
                speak("I didn't understand the time. Please say something like 'remind me to call mom in 30 minutes'")

        elif 'take screenshot' in query:
            take_screenshot()

        elif 'register hotkey' in query:
            try:
                speak("Please say the hotkey combination (e.g., ctrl+alt+s)")
                hotkey = take_command().replace(' ', '+')
                speak("What command should I assign to this hotkey?")
                command = take_command()
                register_hotkey(hotkey, command)
            except Exception as e:
                speak("Failed to register hotkey")
                print(f"Hotkey error: {e}")

        elif 'type' in query:
            speak("What should I type?")
            typing_text = take_command()
            if typing_text:
                pyautogui.write(typing_text, interval=0.1)

        elif 'exit' in query or 'quit' in query or 'goodbye' in query:
            speak("Goodbye sir. Have a nice day!")
            os._exit(0)

        else:
            response = get_gemini_response(query)
            if response:
                speak(response)
            else:
                speak("I'm not sure I understand. Could you repeat that?")


