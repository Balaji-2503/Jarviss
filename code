def add_to_startup():
    try:
        bat_path = os.path.join(os.environ['APPDATA'], 'Microsoft', 'Windows', 'Start Menu', 'Programs', 'Startup',
                                'Jarvis.bat')
        python_exe = sys.executable
        script_path = os.path.abspath(__file__)

        with open(bat_path, 'w') as f:
            f.write(f'@echo off\n')
            f.write(f'start "" "{python_exe}" "{script_path}" -minimized\n')

        speak("JARVIS has been added to startup")
    except Exception as e:
        speak("Failed to add JARVIS to startup")
        print(e)


